{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Pylos AI Gateway — Tenant, Cost & Admin Audit",
  "uid": "pylos-gateway-v1",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["pylos", "llm-gateway", "finops"],
  "panels": [
    {
      "id": 1,
      "title": "Requests by Provider & Model",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(pylos_inference_requests_total[5m])) by (provider, model)", "legendFormat": "{{provider}} / {{model}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Requests per Tenant (Virtual Key)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(pylos_tenant_requests_total[5m])) by (tenant)", "legendFormat": "{{tenant}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Inference Cost Distribution (USD)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(pylos_inference_cost_usd_bucket[5m])) by (le, provider, tenant))", "legendFormat": "p95 {{provider}} ({{tenant}})" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Admin Audit Events",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(pylos_admin_audit_events_total) by (action, outcome)", "legendFormat": "{{action}} ({{outcome}})" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
