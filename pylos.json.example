            "claude-opus-5-5",
            "claude-sonnet-5-5",
            "gpt-oss-120b"
          ],
          "weight": 1.0
        },
        {
          "name": "joseph.zacharie.ai3@gmail.com",
          "value": "joseph.zacharie.ai3@gmail.com",
          "models": [
            "antigravity/*",
            "agy/*",
            "gemini-3.8-flash",
            "gemini-4-argon",
            "gemini-2.5-flash",
            "gemini-2.5-pro",
            "claude-opus-5-5",
            "claude-sonnet-5-5",
            "gpt-oss-120b"
          ],
          "weight": 1.0
        }
      ],
      "network": {
        "timeout_secs": 120,
        "max_retries": 2,
        "retry_backoff_initial_ms": 500,
        "retry_backoff_max_ms": 5000
      },
      "concurrency": {
        "max_concurrency": 10,
        "buffer_size": 100
      }
    }
  },
  "governance": {
