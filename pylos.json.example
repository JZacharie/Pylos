{
  "version": 2,
  "server": {
    "port": 3000,
    "host": "0.0.0.0",
    "log_level": "info",
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 365,
    "max_request_body_size_mb": 100,
    "allowed_origins": [
      "*"
    ],
    "enforce_auth_on_inference": false,
    "queuing": {
      "max_concurrency": 100,
      "max_queue_size": 1000,
      "queue_timeout_ms": 30000
    }
  },
  "providers": {
    "antigravity": {
      "keys": [
        {
          "name": "joseph.zacharie@gmail.com",
